<?xml version="1.0" encoding="UTF-8" ?>
<class name="GodotChorus" inherits="Node" api_type="extension">
	<brief_description>Local asynchronous LLM inference.</brief_description>
	<description>Submit mutable typed request resources. Each accepted request emits exactly one terminal signal. Admission freezes request values and history; provider validation and fitting failures are asynchronous. Preview and counts do not occupy sessions. Input values are immutable snapshots; changing a source resource after submission does not change runtime work. All nodes share generation choices imported from the selected project JSON; request choices take precedence. Configure these through Project Settings under chorus/generation, not a node resource. Changes to model path, provider, load options, or logging while loaded or loading affect the next accepted load. Explicit stop and node destruction block until cleanup is fenced; cancellation admission never waits for that cleanup. Signals require node processing.</description>
	<methods>
		<method name="load_model"><return type="ChorusLoadResult"/><description>Admits a load without waiting for teardown or initialization. Check accepted and correlate load_id with both terminal signals. An accepted load is not ready until model_loaded. Rejected admission emits no signal.</description></method><method name="cancel_load"><return type="bool"/><param index="0" name="load_id" type="int"/></method><method name="get_active_load_id" qualifiers="const"><return type="int"/></method><method name="stop_all"><return type="void"/></method><method name="is_loaded" qualifiers="const"><return type="bool"/></method><method name="supports_embeddings" qualifiers="const"><return type="bool"/></method>
		<method name="generate"><return type="ChorusSubmitResult"/><param index="0" name="request" type="ChorusRequest"/></method>
		<method name="generate_batch"><return type="Array[ChorusSubmitResult]"/><param index="0" name="requests" type="Array[ChorusRequest]"/></method>
		<method name="regenerate"><return type="ChorusSubmitResult"/><param index="0" name="request" type="ChorusRequest"/></method>
		<method name="embed"><return type="ChorusSubmitResult"/><param index="0" name="request" type="ChorusEmbeddingRequest"/></method>
		<method name="embed_batch"><return type="Array[ChorusSubmitResult]"/><param index="0" name="requests" type="Array[ChorusEmbeddingRequest]"/></method>
		<method name="cancel_request"><return type="bool"/><param index="0" name="request_id" type="int"/></method><method name="is_request_active" qualifiers="const"><return type="bool"/><param index="0" name="request_id" type="int"/></method><method name="active_request_for_session" qualifiers="const"><return type="int"/><param index="0" name="session" type="String"/></method>
		<method name="import_conversation_history"><return type="ChorusResult"/><param index="0" name="session" type="StringName"/><param index="1" name="history" type="Array[ChorusMessage]"/></method>
		<method name="export_conversation_history" qualifiers="const"><return type="Array[ChorusMessage]"/><param index="0" name="session" type="StringName"/></method>
		<method name="clear_conversation_history"><return type="ChorusResult"/><param index="0" name="session" type="StringName"/></method>
		<method name="edit_message"><return type="ChorusResult"/><param index="0" name="session" type="StringName"/><param index="1" name="message_id" type="int"/><param index="2" name="content" type="String"/></method>
		<method name="list_conversations" qualifiers="const"><return type="PackedStringArray"/></method><method name="reset_context"><return type="ChorusResult"/></method><method name="last_turn_outcome" qualifiers="const"><return type="int" enum="GodotChorus.TurnOutcomeCode"/><param index="0" name="session" type="String"/></method>
		<method name="render_prompt"><return type="ChorusSubmitResult"/><param index="0" name="request" type="ChorusRequest"/><description>Accepts a read-only, nonoccupying preview. The frozen snapshot completes through [signal prompt_rendered] or [signal generation_error]. Validation and fitting run off-thread.</description></method>
		<method name="count_message_tokens"><return type="ChorusSubmitResult"/><param index="0" name="content" type="String"/><description>Counts literal content asynchronously. No BOS/EOS is added and control-token spellings are literal. Counts exclude role, template and response reservation; they are not additive formatted costs.</description></method>
		<method name="supports_message_token_counting" qualifiers="const"><return type="bool"/></method>
		<method name="similarity_cos" qualifiers="const"><return type="float"/><param index="0" name="array1" type="PackedFloat32Array"/><param index="1" name="array2" type="PackedFloat32Array"/></method>
	</methods>
	<members>
		<member name="model_path" type="String" setter="set_model_path" getter="get_model_path" default="&quot;&quot;">Path to a loose GGUF file. Accepts absolute filesystem paths and Godot [code]res://[/code] or [code]user://[/code] paths. Models inside a PCK must first be extracted to the filesystem.</member><member name="effective_context_size" type="int" getter="get_effective_context_size"/><member name="active_load_id" type="int" getter="get_active_load_id">Outstanding load ID until its terminal is delivered, or -1.</member>
		<member name="provider" type="int" setter="set_provider" getter="get_provider" enum="GodotChorus.ProviderChoice" default="0"/>
		<member name="override_log_level" type="bool" setter="set_override_log_level" getter="get_override_log_level" default="false"/><member name="log_level" type="int" setter="set_log_level" getter="get_log_level" default="2"/>
	</members>
	<signals>
		<signal name="model_load_progress"><param index="0" name="load_id" type="int"/><param index="1" name="model_id" type="String"/><param index="2" name="phase" type="int" enum="ChorusLoadPhase.Value"/><param index="3" name="has_fraction" type="bool"/><param index="4" name="fraction" type="float"/><description>Phase progress; fraction is meaningful only when has_fraction is true. A completed weight fraction is not readiness.</description></signal>
		<signal name="model_loaded"><param index="0" name="load_id" type="int"/><param index="1" name="model_id" type="String"/><description>Terminal publication of a ready model. A prior callback in the same batch can change current readiness; correlate identity and query current state before submitting.</description></signal>
		<signal name="model_load_failed"><param index="0" name="load_id" type="int"/><param index="1" name="model_id" type="String"/><param index="2" name="error_code" type="int"/><param index="3" name="message" type="String"/><description>Terminal failure, including cancellation. The previous engine is not restored.</description></signal>
		<signal name="prompt_rendered"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="StringName"/><param index="2" name="text" type="String"/><param index="3" name="omitted_message_ids" type="PackedInt64Array"/></signal>
		<signal name="message_token_counted"><param index="0" name="request_id" type="int"/><param index="1" name="token_count" type="int"/></signal>
		<signal name="token_generated"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="String"/><param index="2" name="token" type="String"/></signal><signal name="reasoning_token_generated"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="String"/><param index="2" name="token" type="String"/></signal>
		<signal name="generation_complete"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="StringName"/><param index="2" name="message_id" type="int"/><param index="3" name="content" type="String"/><param index="4" name="reasoning" type="String"/></signal>
		<signal name="embedding_complete"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="StringName"/><param index="2" name="embedding" type="PackedFloat32Array"/></signal>
		<signal name="history_truncated"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="StringName"/><param index="2" name="omitted_message_ids" type="PackedInt64Array"/></signal>
		<signal name="generation_error"><param index="0" name="request_id" type="int"/><param index="1" name="session" type="String"/><param index="2" name="error_code" type="int"/><param index="3" name="message" type="String"/></signal><signal name="engine_failed"><param index="0" name="error_code" type="int"/><param index="1" name="message" type="String"/></signal><signal name="log_record"><param index="0" name="level" type="int"/><param index="1" name="message" type="String"/><param index="2" name="fields" type="Dictionary"/><param index="3" name="request_id" type="int"/><param index="4" name="session" type="String"/><param index="5" name="produced_at" type="float"/></signal>
	</signals>
	<constants>
		<constant name="ERR_NONE" value="0" enum="ErrorCode"/><constant name="ERR_MODEL_LOAD" value="1" enum="ErrorCode"/><constant name="ERR_CONTEXT_INIT" value="2" enum="ErrorCode"/><constant name="ERR_DECODE" value="3" enum="ErrorCode"/><constant name="ERR_TOKENIZE" value="4" enum="ErrorCode"/><constant name="ERR_INVALID_REQUEST" value="5" enum="ErrorCode"/><constant name="ERR_ENGINE_NOT_READY" value="6" enum="ErrorCode"/><constant name="ERR_CANCELLED" value="7" enum="ErrorCode"/><constant name="ERR_UNSUPPORTED_MODEL_FORMAT" value="8" enum="ErrorCode"/><constant name="ERR_UNSUPPORTED_FEATURE" value="9" enum="ErrorCode"/><constant name="ERR_UNSUPPORTED_OPTION" value="10" enum="ErrorCode"/><constant name="ERR_SESSION_BUSY" value="11" enum="ErrorCode"/><constant name="ERR_UNKNOWN" value="12" enum="ErrorCode"/>
		<constant name="PROVIDER_LLAMA" value="0" enum="ProviderChoice"/><constant name="PROVIDER_ECHO" value="1" enum="ProviderChoice"/><constant name="TURN_NONE" value="0" enum="TurnOutcomeCode"/><constant name="TURN_COMPLETED" value="1" enum="TurnOutcomeCode"/><constant name="TURN_CANCELLED" value="2" enum="TurnOutcomeCode"/><constant name="TURN_ERRORED" value="3" enum="TurnOutcomeCode"/><constant name="LOG_DEBUG" value="0" enum="LogLevelCode"/><constant name="LOG_INFO" value="1" enum="LogLevelCode"/><constant name="LOG_WARN" value="2" enum="LogLevelCode"/><constant name="LOG_ERROR" value="3" enum="LogLevelCode"/><constant name="LOG_FATAL" value="4" enum="LogLevelCode"/><constant name="LOG_OFF" value="5" enum="LogLevelCode"/>
	</constants>
</class>
