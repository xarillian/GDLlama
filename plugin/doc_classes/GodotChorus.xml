		<method name="clear_conversation_history"><return type="ChorusResult"/><param index="0" name="session" type="StringName"/></method>
		<method name="edit_message"><return type="ChorusResult"/><param index="0" name="session" type="StringName"/><param index="1" name="message_id" type="int"/><param index="2" name="content" type="String"/></method>
		<method name="list_conversations" qualifiers="const"><return type="PackedStringArray"/></method><method name="reset_context"><return type="ChorusResult"/></method><method name="last_turn_outcome" qualifiers="const"><return type="int" enum="GodotChorus.TurnOutcomeCode"/><param index="0" name="session" type="String"/></method>
