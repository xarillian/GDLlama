		<method name="generate_batch"><return type="Array[ChorusSubmitResult]"/><param index="0" name="requests" type="Array[ChorusRequest]"/></method>
		<method name="regenerate"><return type="ChorusSubmitResult"/><param index="0" name="request" type="ChorusRequest"/></method>
