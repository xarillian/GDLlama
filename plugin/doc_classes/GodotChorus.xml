<?xml version="1.0" encoding="UTF-8" ?>
<class name="GodotChorus" inherits="Node" api_type="extension">
	<brief_description>Local asynchronous LLM inference.</brief_description>
	<description>Submit mutable typed request resources. Each accepted request emits exactly one terminal signal. Submission and render values are immutable snapshots; changing a source resource after submission does not change runtime work.</description>
