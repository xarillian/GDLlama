[configuration]

entry_symbol = "llm_library_init"
compatibility_minimum = "4.4"

[libraries]
linux.x86_64 = "res://addons/chorus/bin/libgodot_chorus.so"
windows.x86_64 = "res://addons/chorus/bin/libgodot_chorus.dll"
macos.arm64 = "res://addons/chorus/bin/libgodot_chorus.dylib"

[icons]
GodotChorus = "res://addons/chorus/icon.png"
