[configuration]

entry_symbol = "llm_library_init"
compatibility_minimum = "4.2"

[libraries]
windows.x86_64 = "bin/libgodot_llm.windows.release.amd64.dll"
linux.x86_64 = "bin/libgodot_llm.linux.release.x86_64.so"
macos.universal = "bin/libgodot_llm.darwin.release.universal.dylib"
android.arm64 = "bin/libgodot_llm.android.release.aarch64.so"

[icons]
GDLlama = "res://addons/godot_llm/icon.png"